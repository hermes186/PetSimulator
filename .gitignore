# ==========================================
# PetSimulator Git Ignore Configurations
# ==========================================

# 1. 编译生成物 (Compiled Binaries & Objects)
# 可执行文件与动态/静态库
*.exe
*.out
*.app
*.so
*.dll
*.dylib
*.a
*.lib

# 中间编译产物 (Object files & Debug symbols)
*.o
*.obj
*.pdb
*.ilk
*.suo
build/

# 2. 本地存档与日志 (Local Saves & Logs)
# 玩家的本地游戏存档（不应上传，保持项目干净）
save_data.json
save_data.txt
# 运行日志
*.log
server.log

# 3. 临时文件 (Temporary & Lock files)
# Office (Word, PowerPoint) 临时编辑锁定文件
~$*
# 操作系统临时文件
.DS_Store
Thumbs.db

# 4. 个人编辑器配置 (IDE Settings)
# 本地调试配置（如果包含本地绝对路径，不建议上传）
.vscode/launch.json
.vscode/tasks.json
